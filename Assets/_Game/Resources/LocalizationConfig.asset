      valueData:
      - "\U0001F464 A new character is waiting"
      - "\U0001F464 Nh\xE2n v\u1EADt m\u1EDBi \u0111ang ch\u1EDD b\u1EA1n"
      - "\U0001F464 Un nouveau personnage t\u2019attend"
      - "\U0001F464 \u041D\u043E\u0432\u044B\u0439 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
        \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F"
      - "\U0001F464 \uC0C8\uB85C\uC6B4 \uCE90\uB9AD\uD130\uAC00 \uAE30\uB2E4\uB9AC\uACE0
        \uC788\uC5B4\uC694"
      - "\U0001F464 \u65B0\u3057\u3044\u30AD\u30E3\u30E9\u304C\u5F85\u3063\u3066\u3044\u308B"
      - "\U0001F464 \u0928\u092F\u093E \u092A\u093E\u0924\u094D\u0930 \u0906\u092A\u0915\u093E
        \u0907\u0902\u0924\u091C\u093C\u093E\u0930 \u0915\u0930 \u0930\u0939\u093E
        \u0939\u0948"
      - "\U0001F464 \u041D\u043E\u0432\u0438\u0439 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
        \u0447\u0435\u043A\u0430\u0454 \u043D\u0430 \u0442\u0435\u0431\u0435"

      valueData:
      - "\U0001F3AF Hit or miss?"
      - "\U0001F3AF Nh\u1EAFm tr\xFAng hay tr\u01B0\u1EE3t \u0111\xE2y?"
      - "\U0001F3AF R\xE9ussite ou \xE9chec ?"
      - "\U0001F3AF \u041F\u043E\u043F\u0430\u0434\u0451\u0448\u044C \u0438\u043B\u0438
        \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0451\u0448\u044C\u0441\u044F?"
      - "\U0001F3AF \uB9DE\uD790\uAE4C, \uB193\uCE60\uAE4C?"
      - "\U0001F3AF \u5F53\u305F\u308B\uFF1F\u5916\u308C\u308B\uFF1F"
      - "\U0001F3AF \u0928\u093F\u0936\u093E\u0928\u093E \u0932\u0917\u0947\u0917\u093E
        \u092F\u093E \u091A\u0942\u0915\u0947\u0917\u093E?"
      - "\U0001F3AF \u0412\u043B\u0443\u0447\u0438\u0448 \u0447\u0438 \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0435\u0448\u0441\u044F?"
      - "\U0001F3AF Colpisci o manchi?"

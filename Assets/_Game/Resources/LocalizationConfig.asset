      - "Vui l\xF2ng k\u1EBFt n\u1ED1i m\u1EA1ng \u0111\u1EC3 ti\u1EBFp t\u1EE5c
        ch\u01A1i"
      - "Veuillez vous connecter \xE0 Internet pour continuer \xE0 jouer"
      - "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u0441\u044C
        \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443, \u0447\u0442\u043E\u0431\u044B
        \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u0433\u0440\u0443"
      - "\uACC4\uC18D\uD558\uB824\uBA74 \uC778\uD130\uB137\uC5D0 \uC5F0\uACB0\uD574\uC8FC\uC138\uC694"
      - "\u30D7\u30EC\u30A4\u3092\u7D9A\u3051\u308B\u306B\u306F\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u306B\u63A5\u7D9A\u3057\u3066\u304F\u3060\u3055\u3044"
      - "\u0915\u0943\u092A\u092F\u093E \u0916\u0947\u0932\u0928\u093E \u091C\u093E\u0930\u0940
        \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0907\u0902\u091F\u0930\u0928\u0947\u091F
        \u0938\u0947 \u0915\u0928\u0947\u0915\u094D\u091F \u0915\u0930\u0947\u0902"
      - "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0456\u0442\u044C\u0441\u044F

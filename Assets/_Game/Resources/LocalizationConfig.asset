        \uC2DC\uCCAD\uD558\uC9C0 \uC54A\uACE0\uB3C4 \uBCF4\uC0C1\uC744 \uBC1B\uC744
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      - "\u5E83\u544A\u30B9\u30AD\u30C3\u30D7\u3092\u4F7F\u7528\u3059\u308B\u3068\u3001\u5E83\u544A\u3092\u898B\u305A\u306B\u5831\u916C\u3092\u53D7\u3051\u53D6\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
      - "\u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928\u094B\u0902 \u0915\u094B
        \u091B\u094B\u0921\u093C\u0947\u0902 \u0906\u092A\u0915\u094B \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928
        \u0926\u0947\u0916\u0947 \u092C\u093F\u0928\u093E \u0907\u0928\u093E\u092E
        \u0915\u093E \u0926\u093E\u0935\u093E \u0915\u0930\u0928\u0947 \u0915\u0940
        \u0905\u0928\u0941\u092E\u0924\u093F \u0926\u0947\u0924\u093E \u0939\u0948\u0964"
      - "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u0440\u0435\u043A\u043B\u0430\u043C\u0438
        \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
        \u0432\u0438\u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0443 \u0431\u0435\u0437
        \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0443 \u0440\u0435\u043A\u043B\u0430\u043C\u0438."
      - "Salta gli annunci ti consente di riscattare i premi senza guardare la pubblicit\xE0."

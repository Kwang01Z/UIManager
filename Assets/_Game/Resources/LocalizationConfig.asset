      valueData:
      - Mad Scientist
      - "B\xE1c H\u1ECDc \u0110i\xEAn"
      - Savant fou
      - "\u0411\u0435\u0437\u0443\u043C\u043D\u044B\u0439 \u0443\u0447\u0435\u043D\u044B\u0439"
      - "\uBBF8\uCE5C \uACFC\uD559\uC790"
      - "\u30DE\u30C3\u30C9\u30B5\u30A4\u30A8\u30F3\u30C6\u30A3\u30B9\u30C8"
